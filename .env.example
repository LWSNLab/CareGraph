# Copy to .env and adjust. docker-compose reads these; the Go API reads the
# CAREGRAPH_*/DATABASE_URL/etc. variables when run outside docker.

# Postgres
POSTGRES_USER=caregraph
POSTGRES_PASSWORD=caregraph
POSTGRES_DB=caregraph
# Host port for the dev database (container always listens on 5432 internally).
POSTGRES_PORT=5433

# Typesense
TYPESENSE_API_KEY=devkey

# Go API (local, non-docker run)
# Connects with the READ-ONLY role — a compromised gateway must not be able to
# modify data. Run `make db-roles-dev` once to set the local dev passwords.
CAREGRAPH_HTTP_ADDR=:8080
DATABASE_URL=postgres://caregraph_api:devapi@localhost:5433/caregraph?sslmode=disable
TYPESENSE_URL=http://localhost:8108
REDIS_ADDR=localhost:6379

# Python ingestion pipelines — write-scoped role (no DELETE/DROP on providers,
# INSERT-only on the contribution history).
INGEST_DATABASE_URL=postgres://caregraph_ingest:devingest@localhost:5433/caregraph?sslmode=disable

# The owner credentials above (POSTGRES_USER/PASSWORD) are for migrations only.
# In production all three get distinct passwords from a secret manager; the
# dev values here exist purely so a local container works out of the box.
