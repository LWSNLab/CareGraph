# Copy to .env and adjust. docker-compose reads these; the Go API reads the
# CAREGRAPH_*/DATABASE_URL/etc. variables when run outside docker.

# Postgres
POSTGRES_USER=caregraph
POSTGRES_PASSWORD=caregraph
POSTGRES_DB=caregraph
# Host port for the dev database (container always listens on 5432 internally).
POSTGRES_PORT=5433

# Typesense
TYPESENSE_API_KEY=devkey

# Go API (local, non-docker run)
# Connects with the READ-ONLY role — a compromised gateway must not be able to
# modify data. Run `make db-roles-dev` once to set the local dev passwords.
#
# DATABASE_URL is REQUIRED: the binary has no fallback, because a compiled-in
# default credential is one that eventually gets deployed. Without this file
# `make api` stops and says so.
CAREGRAPH_HTTP_ADDR=:8080
DATABASE_URL=postgres://caregraph_api:devapi@localhost:5433/caregraph?sslmode=disable
TYPESENSE_URL=http://localhost:8108
REDIS_ADDR=localhost:6379

# Host port the containerised API is published on (`make stack`). 8080 is a busy
# port on a developer machine; move it here rather than editing compose.
CAREGRAPH_PORT=8080

# The API and the pipelines refuse an unencrypted connection to a host that is
# not loopback, because sslmode=disable across a network sends credentials and
# queries in the clear — and an *unset* sslmode is worse: libpq treats it as
# `prefer`, which tries TLS and then falls back to plaintext silently.
#
# Not needed for the values above (they are localhost). docker-compose.yml sets
# it for its own services, because from inside a container `db` is
# indistinguishable from a public host. A deployment spanning machines must NOT
# set this and should use sslmode=require instead.
# CAREGRAPH_ALLOW_INSECURE_DB=1

# Key administration (`make apikey-dev`, `make apikeys`) — owner-level, because
# the gateway's own role has SELECT on api_key and nothing more. Also required;
# the tool has no fallback either.
ADMIN_DATABASE_URL=postgres://caregraph:caregraph@localhost:5433/caregraph?sslmode=disable

# Python ingestion pipelines — write-scoped role (no DELETE/DROP on providers,
# INSERT-only on the contribution history).
INGEST_DATABASE_URL=postgres://caregraph_ingest:devingest@localhost:5433/caregraph?sslmode=disable

# The owner credentials above (POSTGRES_USER/PASSWORD) are for migrations only.
# In production all three get distinct passwords from a secret manager; the
# dev values here exist purely so a local container works out of the box.
